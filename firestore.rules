rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection: users can read their own doc, create on signup
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
    }

    // Events collection: anyone can read, organizers can write their own
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'organizer';
      allow update: if request.auth != null
        && (resource.data.createdBy == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ticketsRemaining', 'venues', 'ticketLimit']));
      allow delete: if request.auth != null
        && resource.data.createdBy == request.auth.uid;
    }

    // Registrations collection: users can manage their own registrations
    match /registrations/{regId} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid
            || get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.createdBy == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
    }
  }
}
